// Esquema de Prisma 7 del backend (monolito modular NestJS).
// La URL de conexión NO va aquí: se define en prisma.config.ts (CLI) y en PrismaService (runtime, adapter-pg).
//
// Módulos modelados: Autenticación y usuarios (RF01–RF05) y Comerciantes y puestos (RF06–RF07).
// Pendientes: tiendas virtuales, trabajadores de puesto y cuenta de Mercado Pago (RF08, RF52).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Roles de la plataforma (docs/01-analisis-de-sistema/01-actores.md). Un usuario tiene un único rol (RF03).
enum RolUsuario {
  CLIENTE
  COMERCIANTE
  TRABAJADOR_PUESTO
  ADMINISTRADOR
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum EstadoComerciante {
  ACTIVO
  SUSPENDIDO
}

enum EstadoPuesto {
  ACTIVO
  INACTIVO
}

model Usuario {
  id            String        @id @default(uuid()) @db.Uuid
  /// Siempre en minúsculas (lo garantiza el dominio y el CHECK de la migración).
  email         String        @unique
  nombres       String
  apellidos     String
  telefono      String?
  rol           RolUsuario    @default(CLIENTE)
  estado        EstadoUsuario @default(ACTIVO)
  /// Identidad externa (p. ej. Supabase Auth). Reservada: el mecanismo de autenticación sigue pendiente (DA03).
  authId        String?       @unique
  creadoEn      DateTime      @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime      @updatedAt @db.Timestamptz(3)

  comerciante Comerciante?
  carrito     Carrito?

  @@index([rol])
  @@map("usuarios")
}

model Comerciante {
  id              String            @id @default(uuid()) @db.Uuid
  /// Un usuario con rol COMERCIANTE es titular de, a lo sumo, un perfil de comerciante.
  usuarioId       String            @unique @db.Uuid
  nombreComercial String
  estado          EstadoComerciante @default(ACTIVO)
  creadoEn        DateTime          @default(now()) @db.Timestamptz(3)
  actualizadoEn   DateTime          @updatedAt @db.Timestamptz(3)

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  puestos Puesto[]

  @@map("comerciantes")
}

model Puesto {
  id            String       @id @default(uuid()) @db.Uuid
  comercianteId String       @db.Uuid
  /// Identificador del puesto dentro del mercado (p. ej. "A-12"); único en toda la plataforma.
  codigo        String       @unique
  nombre        String
  estado        EstadoPuesto @default(ACTIVO)
  creadoEn      DateTime     @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime     @updatedAt @db.Timestamptz(3)

  comerciante Comerciante @relation(fields: [comercianteId], references: [id], onDelete: Restrict)
  productos   Producto[]

  @@index([comercianteId])
  @@map("puestos")
}

// ───────────── Productos y categorías (RF09–RF11) / Catálogo (RF16–RF19) ─────────────

enum UnidadVenta {
  UNIDAD
  KILOGRAMO
  GRAMO
  LITRO
  DOCENA
  MANOJO
  PAQUETE
}

/// BORRADOR: aún no visible. PUBLICADO: visible en el catálogo. DESACTIVADO: retirado (RF09 "desactivar").
enum EstadoPublicacion {
  BORRADOR
  PUBLICADO
  DESACTIVADO
}

/// Clasificación plana y global del mercado, administrada por el administrador.
model Categoria {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String
  /// Derivado del nombre (sin tildes, minúsculas, con guiones). Único: impide categorías duplicadas.
  slug          String   @unique
  descripcion   String?
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @db.Timestamptz(3)

  productos Producto[]

  @@map("categorias")
}

model Producto {
  id            String            @id @default(uuid()) @db.Uuid
  puestoId      String            @db.Uuid
  categoriaId   String            @db.Uuid
  nombre        String
  descripcion   String?
  /// Importe en soles con dos decimales (NUMERIC exacto; nunca coma flotante).
  precio        Decimal           @db.Decimal(10, 2)
  unidadVenta   UnidadVenta
  /// Texto libre de la presentación comercial (p. ej. "bolsa de 1 kg").
  presentacion  String?
  estado        EstadoPublicacion @default(BORRADOR)
  creadoEn      DateTime          @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime          @updatedAt @db.Timestamptz(3)

  puesto    Puesto           @relation(fields: [puestoId], references: [id], onDelete: Restrict)
  categoria Categoria        @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  imagenes  ProductoImagen[]
  inventario Inventario?
  carritoItems CarritoItem[]

  /// Permite la clave foránea compuesta (producto, puesto) del inventario: el puesto del inventario no puede divergir del producto.
  @@unique([id, puestoId])
  @@index([puestoId, estado])
  @@index([categoriaId, estado])
  @@index([estado, creadoEn])
  @@map("productos")
}

model ProductoImagen {
  id               String   @id @default(uuid()) @db.Uuid
  productoId       String   @db.Uuid
  /// Ruta del objeto dentro del bucket de almacenamiento (no una URL).
  ruta             String   @unique
  textoAlternativo String?
  orden            Int
  creadoEn         DateTime @default(now()) @db.Timestamptz(3)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, orden])
  @@map("producto_imagenes")
}

// ───────────── Inventario (RF12–RF15, RF25; ADR-003) ─────────────

enum TipoMovimientoInventario {
  INGRESO
  VENTA
  DEVOLUCION
  AJUSTE
  RESERVA
  LIBERACION
}

enum EstadoReservaInventario {
  RESERVADA
  LIBERADA
  CONFIRMADA
}

/// Existencias de un producto en su puesto. Invariante (CHECK): 0 <= stock_reservado <= stock_fisico. Disponible = físico - reservado.
model Inventario {
  id             String   @id @default(uuid()) @db.Uuid
  productoId     String   @unique @map("producto_id") @db.Uuid
  puestoId       String   @map("puesto_id") @db.Uuid
  stockFisico    Int      @default(0) @map("stock_fisico")
  stockReservado Int      @default(0) @map("stock_reservado")
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  producto    Producto               @relation(fields: [productoId, puestoId], references: [id, puestoId], onDelete: Restrict)
  movimientos MovimientoInventario[]
  reservas    ReservaInventario[]

  @@unique([productoId, puestoId])
  @@index([puestoId])
  @@map("inventarios")
}

/// Libro de movimientos (solo se inserta). Variaciones con signo; el saldo posterior permite auditar la cadena.
model MovimientoInventario {
  id                    String                   @id @default(uuid()) @db.Uuid
  inventarioId          String                   @map("inventario_id") @db.Uuid
  tipo                  TipoMovimientoInventario
  variacionFisica       Int                      @map("variacion_fisica")
  variacionReservada    Int                      @map("variacion_reservada")
  stockFisicoDespues    Int                      @map("stock_fisico_despues")
  stockReservadoDespues Int                      @map("stock_reservado_despues")
  motivo                String?
  /// Usuario que originó el movimiento (null en operaciones del sistema, p. ej. expiración). Sin FK: el libro es histórico.
  actorId               String?                  @map("actor_id") @db.Uuid
  /// Clave de operación de la reserva (pedido) que lo originó, si aplica.
  referencia            String?
  creadoEn              DateTime                 @default(now()) @map("creado_en") @db.Timestamptz(3)

  inventario Inventario @relation(fields: [inventarioId], references: [id], onDelete: Restrict)

  @@index([inventarioId, creadoEn])
  @@map("movimientos_inventario")
}

/// Reserva de unidades para una operación (pedido). La clave de operación + inventario es única: base de la idempotencia.
model ReservaInventario {
  id             String                  @id @default(uuid()) @db.Uuid
  claveOperacion String                  @map("clave_operacion")
  inventarioId   String                  @map("inventario_id") @db.Uuid
  cantidad       Int
  estado         EstadoReservaInventario @default(RESERVADA)
  expiraEn       DateTime                @map("expira_en") @db.Timestamptz(3)
  creadoEn       DateTime                @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime                @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  inventario Inventario @relation(fields: [inventarioId], references: [id], onDelete: Restrict)

  @@unique([claveOperacion, inventarioId])
  @@index([estado, expiraEn])
  @@map("reservas_inventario")
}

/// Carrito multivendedor: uno por cliente (RF20–RF24). Guarda solo producto y cantidad; precio y disponibilidad se leen vigentes.
model Carrito {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @unique @map("usuario_id") @db.Uuid
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  usuario Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items   CarritoItem[]

  @@map("carritos")
}

model CarritoItem {
  id            String   @id @default(uuid()) @db.Uuid
  carritoId     String   @map("carrito_id") @db.Uuid
  productoId    String   @map("producto_id") @db.Uuid
  /// Puesto del producto (RF21); la clave foránea compuesta impide que diverja del puesto real del producto.
  puestoId      String   @map("puesto_id") @db.Uuid
  cantidad      Int
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  carrito  Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId, puestoId], references: [id, puestoId], onDelete: Cascade)

  @@unique([carritoId, productoId])
  @@index([productoId])
  @@map("carrito_items")
}
