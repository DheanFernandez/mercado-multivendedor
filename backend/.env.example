# Copiar a backend/.env (archivo ignorado por Git) y completar con los valores reales.
# Este archivo se versiona: NUNCA escribir aquí credenciales reales.

PORT=3000
# Origen del frontend permitido por CORS y destino de los enlaces de los correos de Supabase.
FRONTEND_URL= "http://localhost:3001"

# --- PostgreSQL (Supabase) ---
# Supabase Dashboard > Connect (o Project Settings > Database) > Connection string.
# Si la contraseña tiene caracteres especiales, codificarla (p. ej. "/" -> %2F).
# Runtime de la aplicación (PrismaService + @prisma/adapter-pg): pooler.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<REGION>.pooler.supabase.com:5432/postgres"
# CLI de Prisma (migrate): conexión directa o Session pooler (puerto 5432).
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<REGION>.pooler.supabase.com:5432/postgres"
# DATABASE_POOL_MAX=10

# --- Supabase Auth ---
# Project Settings > Data API (o API) > Project URL. Ejemplo: https://<PROJECT_REF>.supabase.co
SUPABASE_URL="https://qucwssitedhdcsxhyomi.supabase.co"
# Project Settings > API Keys > clave pública ("Publishable key" sb_publishable_... o "anon" en claves legacy).
# Es pública por diseño; el backend la usa para el registro (signup).
SUPABASE_ANON_KEY= "sb_publishable_H3aDa3i6qXLXTtWEM_Sucw_C-MFPB5v"
# Project Settings > API Keys > "Secret key" (sb_secret_...) o "service_role" (legacy).
# SECRETA: solo backend. Se usa para invitar usuarios creados por el administrador. Nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Solo si el proyecto aún usa el secreto JWT legacy (HS256): Project Settings > JWT Keys > Legacy JWT secret.
# Si el proyecto usa claves de firma asimétricas (recomendado), dejar vacío: se verifican con el JWKS de SUPABASE_URL.
SUPABASE_JWT_SECRET=

# --- Mercado Pago (Sandbox; NO implementado aún) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
