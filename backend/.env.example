# Copiar a backend/.env (archivo ignorado por Git) y completar con los valores reales.
# Este archivo se versiona: NUNCA escribir aquí credenciales reales, solo marcadores <ASI>.

# Puerto de la API. Pública (no es secreto).
PORT=3000
# Origen del frontend permitido por CORS y destino de los enlaces de los correos de Supabase Auth. Pública.
FRONTEND_URL="http://localhost:3001"

# --- PostgreSQL (Supabase) ---
# Panel de Supabase > botón Connect (o Project Settings > Database) > Connection string.
# Si la contraseña tiene caracteres especiales, codificarla (p. ej. "/" -> %2F, "@" -> %40).
# <REGION> es el prefijo del pooler que muestra el panel (p. ej. aws-0-sa-east-1; puede ser aws-1-...). Copiarlo tal cual.

# DATABASE_URL: Transaction pooler (puerto 6543). La usa la aplicación en ejecución (PrismaService + @prisma/adapter-pg).
# Connect > Transaction pooler. SECRETA (contiene la contraseña de la base).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<REGION>.pooler.supabase.com:6543/postgres"
# DIRECT_URL: Session pooler (puerto 5432). La usa SOLO la CLI de Prisma para migraciones (prisma.config.ts).
# Connect > Session pooler. SECRETA. Debe ser distinta de DATABASE_URL: el pooler transaccional no admite migraciones.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<REGION>.pooler.supabase.com:5432/postgres"
# Tamaño máximo del pool de conexiones (opcional, 10 por defecto). Pública.
# DATABASE_POOL_MAX=10

# --- Supabase Auth ---
# SUPABASE_URL: Project Settings > Data API > Project URL (https://<PROJECT_REF>.supabase.co). Pública.
# También sirve para obtener el JWKS con que se verifica el JWT (<SUPABASE_URL>/auth/v1/.well-known/jwks.json).
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
# SUPABASE_ANON_KEY: Project Settings > API Keys > Publishable key (sb_publishable_...). PÚBLICA por diseño.
# El backend la usa para el registro (signup).
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY: Project Settings > API Keys > Secret key (sb_secret_...). SECRETA, solo backend.
# Se usa para invitar/eliminar usuarios (admin) y para subir imágenes a Storage. Nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET: DEJAR VACÍO en proyectos con llaves de firma asimétricas (los proyectos nuevos): el token se
# verifica con el JWKS de SUPABASE_URL. Si se define, el backend verifica con HS256 y rechazará los tokens ES256/RS256.
# Solo para proyectos legacy: Project Settings > JWT Keys > Legacy JWT Secret. SECRETA.
SUPABASE_JWT_SECRET=

# --- Supabase Storage (imágenes de productos) ---
# Nombre del bucket PÚBLICO (Storage > New bucket). Pública (es solo un nombre). Usa SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_STORAGE_BUCKET=productos
# Opcional: origen de las URL públicas de LECTURA de imágenes (`<origen>/<ruta>`), p. ej. una CDN. Pública.
# Vacío = URL de Supabase Storage (comportamiento normal). La demostración local la fija sola (ops/demo/demo-db.mjs);
# no la defina aquí para trabajar con Supabase.
ALMACEN_URL_PUBLICA=

# --- Documentación de la API ---
# Swagger UI en /api/docs y el documento en /api/docs-json están activos por defecto. OPENAPI_HABILITADO=false los desactiva.
# OPENAPI_HABILITADO=true

# --- Mercado Pago (Sandbox) ---
# RESERVADAS: el código todavía no las lee (integración no implementada). Ambas serían SECRETAS
# (Mercado Pago > Tus integraciones > credenciales de prueba / Webhooks).
# MERCADOPAGO_ACCESS_TOKEN=<MP_ACCESS_TOKEN>
# MERCADOPAGO_WEBHOOK_SECRET=<MP_WEBHOOK_SECRET>
