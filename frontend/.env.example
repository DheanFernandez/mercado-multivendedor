# Copiar a frontend/.env.local (ignorado por Git). Todo lo que empieza con NEXT_PUBLIC_ llega al navegador:
# aquí SOLO van valores públicos. NUNCA poner la clave "service_role"/"secret" en este archivo.
# Este archivo se versiona: solo marcadores <ASI>, nunca valores reales.

# Panel de Supabase > Project Settings > Data API > Project URL (https://<PROJECT_REF>.supabase.co). PÚBLICA.
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
# Panel de Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...). PÚBLICA por diseño.
NEXT_PUBLIC_SUPABASE_ANON_KEY=# URL del backend NestJS (local: http://localhost:3000; producción: la URL pública del backend). PÚBLI
NEXT_PUBLIC_API_URL=http://localhost:3000
